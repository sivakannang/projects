# Exchange lab build
#
#   make                 release build (default): optimised, with symbols for perf
#   make BUILD=debug     debug build: no optimisation, address + UB sanitizers
#   make BUILD=tsan      ThreadSanitizer build: detects data races between threads
#   make test            build and run every tests/*.cpp, then the pipeline test
#   make bench           build and run every bench/*.cpp with default options (takes minutes)
#   make clean           remove build/
#   make info            print compiler and flags in use
#
# Output: build/<BUILD>/bin/<program>, tests in bin/tests/, benchmarks in bin/bench/

BUILD ?= release
CXX   ?= g++

APPS     := feeder receiver processor sender monitor
TESTS    := $(basename $(notdir $(wildcard tests/*.cpp)))
BENCHES  := $(basename $(notdir $(wildcard bench/*.cpp)))
LIB_SRCS := $(wildcard common/*.cpp engine/*.cpp)

OUT     := build/$(BUILD)
OBJ_DIR := $(OUT)/obj
BIN_DIR := $(OUT)/bin

ARCH := $(shell uname -m)
OS   := $(shell uname -s)

CXXFLAGS := -std=c++20 -Wall -Wextra -Wpedantic -pthread -Icommon -Iengine -MMD -MP
CXXFLAGS += -DLAB_BUILD='"$(BUILD)"'   # benchmarks print which build produced a number
LDLIBS   := -pthread

# Tune for the CPU we build on (x86 uses -march, ARM clang uses -mcpu)
ifeq ($(ARCH),x86_64)
CPU_FLAGS := -march=native
else
CPU_FLAGS := -mcpu=native
endif

ifeq ($(BUILD),release)
# -O2 speed, -g symbols, frame pointers so perf can walk call stacks
CXXFLAGS += -O2 -g -fno-omit-frame-pointer $(CPU_FLAGS) -DNDEBUG
else ifeq ($(BUILD),debug)
CXXFLAGS += -O0 -g3 -fno-omit-frame-pointer -fsanitize=address,undefined
LDFLAGS  += -fsanitize=address,undefined
else ifeq ($(BUILD),tsan)
# ThreadSanitizer can't be combined with AddressSanitizer, so it gets its own build
CXXFLAGS += -O1 -g -fno-omit-frame-pointer -fsanitize=thread
LDFLAGS  += -fsanitize=thread
else
$(error BUILD must be release, debug or tsan, got '$(BUILD)')
endif

ifeq ($(OS),Linux)
LDLIBS += -lrt   # shm_open on older glibc
endif

LIB_OBJS := $(LIB_SRCS:%.cpp=$(OBJ_DIR)/%.o)
APP_OBJS := $(APPS:%=$(OBJ_DIR)/apps/%.o)
BINS     := $(APPS:%=$(BIN_DIR)/%)
TEST_OBJS := $(TESTS:%=$(OBJ_DIR)/tests/%.o)
TEST_BINS := $(TESTS:%=$(BIN_DIR)/tests/%)
BENCH_OBJS := $(BENCHES:%=$(OBJ_DIR)/bench/%.o)
BENCH_BINS := $(BENCHES:%=$(BIN_DIR)/bench/%)

.PHONY: all clean info test bench
all: $(BINS) $(TEST_BINS) $(BENCH_BINS)

# Static pattern rules: name each .o explicitly, so make keeps them and rebuilds incrementally
$(BINS): $(BIN_DIR)/%: $(OBJ_DIR)/apps/%.o $(LIB_OBJS)
	@mkdir -p $(@D)
	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@

$(TEST_BINS): $(BIN_DIR)/tests/%: $(OBJ_DIR)/tests/%.o $(LIB_OBJS)
	@mkdir -p $(@D)
	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@

$(BENCH_BINS): $(BIN_DIR)/bench/%: $(OBJ_DIR)/bench/%.o $(LIB_OBJS)
	@mkdir -p $(@D)
	$(CXX) $(LDFLAGS) $^ $(LDLIBS) -o $@

# Runs every test; stops at the first failure
test: $(TEST_BINS) $(BINS)
	@for t in $(TEST_BINS); do echo "== $$t"; $$t || exit 1; done
	@echo "== tests/pipeline_test.sh"; tests/pipeline_test.sh $(BIN_DIR)

# Benchmarks are slow, so they are not part of `make test`
bench: $(BENCH_BINS)
	@for b in $(BENCH_BINS); do echo "== $$b"; $$b || exit 1; done

$(OBJ_DIR)/%.o: %.cpp
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rf build

info:
	@echo "BUILD    = $(BUILD)"
	@echo "CXX      = $(CXX) ($(shell $(CXX) --version | head -1))"
	@echo "CXXFLAGS = $(CXXFLAGS)"
	@echo "LDLIBS   = $(LDLIBS)"
	@echo "APPS     = $(APPS)"

# Header dependencies generated by -MMD: editing a .hpp rebuilds what includes it
-include $(APP_OBJS:.o=.d) $(LIB_OBJS:.o=.d) $(TEST_OBJS:.o=.d) $(BENCH_OBJS:.o=.d)
